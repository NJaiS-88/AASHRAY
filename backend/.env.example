# Backend environment variables
# Copy this file to .env and fill in the values

PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
JWT_SECRET=your_super_secret_jwt_key_here

# Comma-separated list of allowed frontend origins
# For Render deployment, add your Vercel URL here
FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app

# Python ML classifier microservice URL (run ml_service/start.bat first)
ML_SERVICE_URL=http://localhost:5001
